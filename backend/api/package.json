{
  "name": "@platform/api",
  "version": "0.1.0",
  "private": true,
  "description": "Event Platform — Central NestJS API (modular monolith)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern=spec",
    "test:integration": "jest --testPathPattern=e2e",
    "test:cov": "jest --coverage",
    "clean": "rimraf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:seed:staging": "ts-node src/scripts/staging-seed.ts",
    "db:inventory": "ts-node src/scripts/staging-schema-inventory.ts",
    "test:concurrency": "ts-node src/scripts/staging-concurrency-test.ts",
    "test:rls": "ts-node src/scripts/staging-rls-test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/terminus": "^10.2.0",
    "@nestjs/throttler": "^5.1.0",
    "@platform/types": "workspace:*",
    "@platform/validation": "workspace:*",
    "@platform/config": "workspace:*",
    "@supabase/supabase-js": "^2.43.0",
    "drizzle-orm": "^0.31.0",
    "postgres": "^3.4.0",
    "zod": "^3.23.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "uuid": "^10.0.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.22.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  }
}
