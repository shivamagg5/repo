# Backend API — Environment Variables
# Copy to .env and fill in values.
# See docs/ENVIRONMENT_VARIABLES.md for full documentation.
# NEVER commit .env to git.

NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars

# Supabase — fill in from your Supabase project dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here-NEVER-expose-to-frontend

# PostgreSQL connection string (Supabase pooler)
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Redis (run: docker compose up -d redis)
REDIS_URL=redis://localhost:6379

# Storage
STORAGE_BUCKET_EVENTS=event-images
STORAGE_BUCKET_VENUES=venue-images
STORAGE_BUCKET_AVATARS=user-avatars

# Observability
LOG_LEVEL=debug
SENTRY_DSN=
