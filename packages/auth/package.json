{
  "name": "@platform/auth",
  "version": "0.1.0",
  "private": true,
  "description": "Supabase Auth utilities — client-safe helpers and React auth context",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "pnpm build && node --test dist/index.spec.js dist/analytics.spec.js",
    "test:unit": "pnpm test",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@platform/api-client": "workspace:*",
    "@platform/types": "workspace:*",
    "@supabase/supabase-js": "^2.43.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0"
  }
}
