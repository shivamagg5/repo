# =============================================================================
# EVENT ECOSYSTEM — ENVIRONMENT VARIABLES EXAMPLE
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# See docs/ENVIRONMENT_VARIABLES.md for full documentation.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------
# Your Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe for browser/mobile clients
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — BACKEND ONLY — NEVER expose to frontend or mobile
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# PostgreSQL connection string (Supabase transaction pooler)
# Use the pooler URL from Supabase dashboard → Project Settings → Database
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# -----------------------------------------------------------------------------
# BACKEND
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

# JWT secret for internal token signing
JWT_SECRET=your-strong-random-secret-min-32-chars

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
# Local development: run `docker compose up -d redis`
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# STORAGE
# -----------------------------------------------------------------------------
STORAGE_BUCKET_EVENTS=event-images
STORAGE_BUCKET_VENUES=venue-images
STORAGE_BUCKET_AVATARS=user-avatars

# -----------------------------------------------------------------------------
# PAYMENTS (Placeholder — Phase 5)
# -----------------------------------------------------------------------------
# PAYMENT_PROVIDER=razorpay
# PAYMENT_KEY_ID=your-razorpay-key-id
# PAYMENT_KEY_SECRET=your-razorpay-key-secret
# PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------------------------------------------------------
# NOTIFICATIONS (Placeholder — Phase 11)
# -----------------------------------------------------------------------------
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=your-email-api-key
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# FCM_SERVER_KEY=your-fcm-server-key

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=debug
