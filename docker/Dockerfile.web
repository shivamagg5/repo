# =============================================================================
# Multi-stage Dockerfile for Next.js 15 Web Portals
# Builds standalone Next.js bundles with Node 22 Alpine and non-root execution
# Usage: docker build --build-arg APP_NAME=consumer-web -f docker/Dockerfile.web .
# =============================================================================

# --- Stage 1: Base ---
FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.13.1 --activate
WORKDIR /app

# --- Stage 2: Dependencies & Build ---
FROM base AS builder
ARG APP_NAME=consumer-web
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps

RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

# Build shared dependencies
RUN pnpm --filter @platform/types build
RUN pnpm --filter @platform/config build
RUN pnpm --filter @platform/design-tokens build
RUN pnpm --filter @platform/api-client build
RUN pnpm --filter @platform/validation build
RUN pnpm --filter @platform/ui build
RUN pnpm --filter @platform/auth build

# Build target Next.js app
RUN pnpm --filter @platform/${APP_NAME} build

# --- Stage 3: Runner ---
FROM node:22-alpine AS runner
ARG APP_NAME=consumer-web
WORKDIR /app

RUN apk add --no-cache dumb-init

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

USER node

# Copy standalone output & static assets
COPY --chown=node:node --from=builder /app/apps/${APP_NAME}/public ./public
COPY --chown=node:node --from=builder /app/apps/${APP_NAME}/.next/standalone ./
COPY --chown=node:node --from=builder /app/apps/${APP_NAME}/.next/static ./.next/static

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "apps/${APP_NAME}/server.js"]
