# =============================================================================
# consumer-web — Environment Variables
# Copy this file to .env.local (git-ignored) and fill in real values.
# NEVER commit .env.local or any file containing real secrets/credentials.
# =============================================================================

# Supabase — Authentication
# Auth is handled entirely by the Supabase client SDK using the ANON key.
# There is no /auth/login backend endpoint — Supabase handles login/signup/OAuth.
# After Supabase login, the app calls POST /api/v1/auth/sync with the JWT.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Application
NEXT_PUBLIC_APP_NAME=EventPlatform

# Razorpay — Payment SDK (public key only — NEVER expose secret key here)
# Used to initialize the Razorpay checkout modal on the consumer checkout page.
# Obtain from: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
