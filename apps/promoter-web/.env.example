# =============================================================================
# promoter-web — Environment Variables
# Copy this file to .env.local (git-ignored) and fill in real values.
# NEVER commit .env.local or any file containing real secrets/credentials.
# =============================================================================

# Supabase — Authentication
# Auth is handled entirely by the Supabase client SDK using the ANON key.
# There is no /auth/login backend endpoint — Supabase handles login/signup/OAuth.
# After Supabase login, the app calls POST /api/v1/auth/sync with the JWT.
# Only users with 'promoter' role will be granted access to this dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Consumer Web URL — used to construct referral links displayed to promoters.
# e.g. https://eventplatform.com/events/slug?ref=CAMPAIGN_CODE
NEXT_PUBLIC_CONSUMER_WEB_URL=http://localhost:3000

