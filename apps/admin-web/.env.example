# =============================================================================
# admin-web — Environment Variables
# Copy this file to .env.local (git-ignored) and fill in real values.
# NEVER commit .env.local or any file containing real secrets/credentials.
# =============================================================================

# Supabase — Authentication
# Auth is handled entirely by the Supabase client SDK using the ANON key.
# There is no /auth/login backend endpoint — Supabase handles login/signup/OAuth.
# After Supabase login, the app calls POST /api/v1/auth/sync with the JWT.
# IMPORTANT: admin-web requires platform-admin role (super_admin or operations_admin).
# IMPORTANT: admin-web enforces Supabase MFA (TOTP) for sensitive operations.
# Users without the platform-admin role are redirected away at login.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

